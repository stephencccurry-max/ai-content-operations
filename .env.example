POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=ai_content_ops
DATABASE_URL=postgresql+psycopg://app:change-me-in-local-env@db:5432/ai_content_ops
INTERNAL_API_TOKEN=change-me-in-local-env
EXPORT_DIR=data/exports
APP_VERSION=0.1.0
# Compose 内 n8n 访问 API：http://api:8000
# 宿主机跑 FastAPI、仅 n8n 在容器内时：http://host.docker.internal:8000
INTERNAL_API_BASE_URL=http://api:8000
# Provider 选择：mock（默认，与 pytest 一致）或 live 值 zhipu / tavily
LLM_PROVIDER=mock
SEARCH_PROVIDER=mock
# Tavily 搜索 Key（M2 live）。申请：https://tavily.com ；mock 时可留空
TAVILY_API_KEY=
# 智谱 GLM（M2 live）。真实 Key 只写本机 .env，不要提交
ZHIPU_API_KEY=
# 默认 Coding Plan 端点；标准 API 有余额时可改为 https://open.bigmodel.cn/api/paas/v4
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
ZHIPU_MODEL=glm-5.3
# Adapter HTTP 超时（秒）；Compose api 服务会透传
PROVIDER_TIMEOUT_SECONDS=45
