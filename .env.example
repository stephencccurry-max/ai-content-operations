POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=ai_content_ops
DATABASE_URL=postgresql+psycopg://app:change-me-in-local-env@db:5432/ai_content_ops
INTERNAL_API_TOKEN=change-me-in-local-env
EXPORT_DIR=data/exports
APP_VERSION=0.1.0
# Compose 内 n8n 访问 API：http://api:8000
# 宿主机跑 FastAPI、仅 n8n 在容器内时：http://host.docker.internal:8000
INTERNAL_API_BASE_URL=http://api:8000
